<% layout("/layouts/boilerplate") %>

<section class="form-page">

    <div class="form-header">

        <span class="form-eyebrow">UPDATE EXPERIENCE</span>

        <h1>Edit Experience</h1>

        <p>
            Make changes to your experience and save
            the updated version.
        </p>

    </div>


    <div class="form-card">

        <form
            action="/experiences/<%= listing._id %>?_method=PUT"
            method="post"
            class="needs-validation" novalidate
            enctype="multipart/form-data"
        >

            <div class="form-group">

                <label for="title">
                    Experience Title
                </label>

                <input
                class="form-control"
                    id="title"
                    type="text"
                    name="title"
                    value="<%= listing.title %>"
                    placeholder="Enter title..."
                    required
                >

            </div>


            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="7"
                    placeholder="Describe your experience..."
                    required
                ><%= listing.description %></textarea>

            </div>


            <div class="mb-3">
                <h6>Original Listing Image :</h6>
                <img src="<%= originalImageUrl %>" alt="Edit">
            </div>

            <div class="form-group">

                <label for="image">
               Upload New Image
                </label>

                <input
                class="form-control"
                    id="image"
                    type="file"
                    name="image"
                    
                    placeholder="https://example.com/image.jpg"
                 
                >

                <small>
                    Replace the current image URL if required.
                </small>

            </div>


            <div class="form-group">

                <label for="category">
                    Category
                </label>

                <input
                class="form-control"
                    id="category"
                    type="text"
                    name="category"
                    value="<%= listing.category %>"
                    placeholder="Technology, Sports, Anime..."
                    required
                >

            </div>


            <div class="form-actions">

                <a
                    href="/experiences/<%= listing._id %>"
                    class="cancel-btn"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    class="submit-btn"
                >
                    Save Changes →
                </button>

            </div>

        </form>

    </div>

</section>